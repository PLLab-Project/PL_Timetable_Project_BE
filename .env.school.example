# 학교 서버 템플릿입니다. 직접 복사하지 말고 원클릭 설치를 실행합니다.
# ./install-school.sh
# 설치 스크립트가 POSTGRES_PASSWORD를 256비트 난수로 설정한 뒤 .env를 생성합니다.

POSTGRES_DB=pl_timetable
POSTGRES_USER=pl_timetable
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=15432

# Windows 학교 서버의 cloudflared 서비스가 이 루프백 주소로 연결합니다.
# 0.0.0.0으로 변경하거나 API·DB 포트를 인터넷에 직접 공개하지 않습니다.
API_BIND_ADDRESS=127.0.0.1
API_PORT=18082
APP_IMAGE_TAG=school
APP_VERSION=0.0.1-SNAPSHOT
SERVER_FORWARD_HEADERS_STRATEGY=framework

SPRING_PROFILES_ACTIVE=prod
ALLOWED_ORIGINS=https://frontend.example.ac.kr,http://localhost:5173
ALLOWED_ORIGIN_PATTERNS=https://pl-timetable-project-fe.vercel.app,http://localhost:[*],http://127.0.0.1:[*]
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none
OPENAPI_ENABLED=true

SCHOOL_EMAIL_DOMAIN=daejin.ac.kr
OTP_EXPIRATION_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY=smtp
OTP_FROM=no-reply@example.ac.kr

SMTP_HOST=smtp.example.ac.kr
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
